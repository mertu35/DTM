rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcılar
    match /users/{userId} {
      // Herkes kendi kaydını, admin/superadmin herkesi okuyabilir.
      // Sıradan kullanıcıların diğer kullanıcıların profilini (e-posta, son giriş vb.)
      // okuması kesinlikle engellenmiştir (veri sızıntısı koruması).
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']));

      // Admin ve superadmin yazabilir; ancak superadmin atama/değiştirme yalnızca mevcut superadmin yapabilir
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
            (request.resource == null || request.resource.data.role != 'superadmin') &&
            (!exists(/databases/$(database)/documents/users/$(userId)) || resource.data.role != 'superadmin')
          )
        );

      // Kullanıcı kendi profilini sınırlı alanlarda güncelleyebilir.
      // emailVerified alanını yalnızca Firebase Auth'un kriptografik token doğrulaması (email_verified)
      // true olduğunda true yapabilir; böylece Auth doğrulaması olmadan profil sahteciliği engellenir.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'avatar', 'okunanDuyurular', 'silinenDuyurular', 'gorulenGeriGonderilenler', 'lastLogin',
          'lastGonderilenVisit', 'lastOnayliVisit',
          'email', 'emailVerified', 'pendingEmail', 'emailUpdatedAt'
        ]) &&
        (
          !('emailVerified' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.emailVerified == false ||
          request.auth.token.email_verified == true
        );

      // Şifre gibi hassas alanlar: sadece sahibi veya admin/superadmin okuyup yazabilir/silebilir
      match /secret/{secretId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == userId ||
           (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']));
      }
    }

    // Genel Kullanıcı Bilgisi (Gerçekleştirmeci dropdown listesi ve personel görünümü için)
    // Sadece kayıtlı oturum açmış kullanıcılar okuyabilir. Yalnızca displayName ve role içerir.
    match /publicUsers/{userId} {
      allow read: if request.auth != null;
      // Admin ve superadmin her şeyi yazabilir / silebilir
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
      // Kullanıcı kendi kaydını oluşturabilir veya güncelleyebilir; ancak 'role' alanını keyfi değiştiremez
      // (rolü yalnızca admin belirler; kullanıcının yazdığı rol users tablosundaki gerçek rolüyle birebir aynı olmalıdır)
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        (
          !('role' in request.resource.data) ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
           get(/databases/$(database)/documents/users/$(userId)).data.role == request.resource.data.role)
        );
    }

    // Duyurular
    match /duyurular/{duyuruId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Projeler
    match /projeler/{projeId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerceklestirmeci' &&
          resource.data.atananGerceklestirmeciUid == request.auth.uid));

      // Sadece yetkili kullanıcı kendi adına, taslak olarak oluşturabilir
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'taslak';

      allow update: if request.auth != null && (
        // Admin/superadmin her alanı değiştirebilir
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
        // Gerçekleştirmeci sadece kendi atandığı ve 'gonderildi' durumundaki projeyi güncelleyebilir
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerceklestirmeci' &&
         resource.data.atananGerceklestirmeciUid == request.auth.uid &&
         resource.data.status == 'gonderildi' &&
         request.resource.data.status in ['gonderildi', 'onaylandi', 'geri_gonderildi']) ||
        // Proje sahibi:
        // Yalnızca proje taslak veya geri_gonderildi aşamasındayken güncelleyebilir.
        // gonderildi, onaylandi veya arsivlendi aşamasında proje sahibi güncelleyemez.
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status in ['taslak', 'geri_gonderildi'] &&
          request.resource.data.userId == request.auth.uid &&
          // Sahip kendi projesini doğrudan 'geri_gonderildi' durumuna sokamaz; yalnızca gerceklestirmeci/admin yapabilir.
          (
            (resource.data.status == 'taslak' && request.resource.data.status in ['taslak', 'gonderildi']) ||
            (resource.data.status == 'geri_gonderildi' && request.resource.data.status in ['geri_gonderildi', 'gonderildi'])
          ) &&
          // 'gonderildi' durumuna geçiriliyorsa gerçekleştirmeci atanmış olmalıdır
          (
            request.resource.data.status != 'gonderildi' ||
            (request.resource.data.atananGerceklestirmeciUid is string && request.resource.data.atananGerceklestirmeciUid.size() > 0)
          ) &&
          (
            resource.data.get('locked', false) != true ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'lockedAt', 'lockedBy']) && request.resource.data.locked == false)
          )
        )
      );

      allow delete: if request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
        (resource.data.userId == request.auth.uid && resource.data.status in ['taslak', 'geri_gonderildi'] && resource.data.get('locked', false) != true)
      );

      // Projeye ait ekler / dosyalar (Firestore alt koleksiyonu ve parçaları)
      match /dosyalar/{dosyaId=**} {
        allow read: if request.auth != null && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
          (exists(/databases/$(database)/documents/projeler/$(projeId)) && get(/databases/$(database)/documents/projeler/$(projeId)).data.userId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/projeler/$(projeId)) && get(/databases/$(database)/documents/projeler/$(projeId)).data.atananGerceklestirmeciUid == request.auth.uid)
        );

        allow create, delete: if request.auth != null && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
          (exists(/databases/$(database)/documents/projeler/$(projeId)) && get(/databases/$(database)/documents/projeler/$(projeId)).data.userId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/projeler/$(projeId)) && get(/databases/$(database)/documents/projeler/$(projeId)).data.atananGerceklestirmeciUid == request.auth.uid)
        );
      }
    }

    // Referans verileri (kullanıcıya özel)
    match /referans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Global referans verileri (admin, superadmin ve gerceklestirmeci yönetir)
    match /globalReferans/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'gerceklestirmeci'];
    }

    // Kullanıcı adı → e-posta eşlemesi.
    // Oturum açılmadan e-posta sızıntısını önlemek için dışarıdan erişime kapatılmıştır.
    // Yalnızca admin/superadmin erişebilir.
    match /usernameEmailMap/{username} {
      allow read, write: if request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }

    // Vision API aylık kullanım sayacı
    // Sayaç sadece artabilir — reset/azaltma engellenir, aylık tavan (500 sayfa) kontrol edilir
    match /visionUsage/{ayDoc} {
      allow read: if request.auth != null;
      // İlk yazım: en fazla 50 sayfa, tavan 500
      allow create: if request.auth != null &&
        request.resource.data.sayfaSayisi is number &&
        request.resource.data.sayfaSayisi >= 0 &&
        request.resource.data.sayfaSayisi <= 500;
      // Güncelleme: sayaç sadece artabilir, tek istekte en fazla 50 artış, tavan 500
      allow update: if request.auth != null &&
        request.resource.data.sayfaSayisi is number &&
        request.resource.data.sayfaSayisi > resource.data.sayfaSayisi &&
        request.resource.data.sayfaSayisi - resource.data.sayfaSayisi <= 50 &&
        request.resource.data.sayfaSayisi <= 500;
    }

    // Uygulama sürüm bilgisi ("Hakkında" sayfasındaki güncelleme kontrolü)
    // Herkes okuyabilir, sadece admin/superadmin güncelleyebilir.
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
  }
}
