rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcılar
    match /users/{userId} {
      // Herkes kendi kaydını, admin/superadmin herkesi okuyabilir.
      // Sıradan kullanıcılar için okuma yalnızca 'gerceklestirmeci' rolündeki
      // kayıtlarla sınırlı — proje gönderim ekranı bu listeyi okuyabilmeli,
      // ama kullanıcılar birbirinin rolünü/e-postasını görmemeli.
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         resource.data.role == 'gerceklestirmeci' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']));
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'avatar', 'okunanDuyurular', 'gorulenProjeler', 'lastLogin',
          'lastGonderilenVisit', 'lastOnayliVisit',
          'email', 'emailVerified', 'pendingEmail', 'emailUpdatedAt'
        ]);

      // Şifre gibi hassas alanlar: sadece sahibi veya admin/superadmin okuyup yazabilir
      match /secret/{secretId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == userId ||
           (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']));
      }
    }

    // Duyurular
    match /duyurular/{duyuruId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Projeler
    match /projeler/{projeId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerceklestirmeci' &&
          resource.data.atananGerceklestirmeciUid == request.auth.uid));

      // Sadece kendi adına, taslak olarak oluşturabilir
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'taslak';

      allow update: if request.auth != null && (
        // Admin/superadmin her alanı değiştirebilir
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']) ||
        // Gerçekleştirmeci sadece kendi atandığı projeyi güncelleyebilir
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gerceklestirmeci' &&
         resource.data.atananGerceklestirmeciUid == request.auth.uid) ||
        // Proje sahibi: onaylandi ve arsivlendi statüsüne geçemez
        (resource.data.userId == request.auth.uid &&
         !(request.resource.data.status in ['onaylandi', 'arsivlendi']))
      );

      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Referans verileri (kullanıcıya özel)
    match /referans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Global referans verileri (admin, superadmin ve gerceklestirmeci yönetir)
    match /globalReferans/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'gerceklestirmeci'];
    }

    // Kullanıcı adı → doğrulanmış e-posta eşlemesi.
    // Giriş ekranı ve "Şifremi Unuttum" akışı henüz oturum açılmadan çalışması gerektiği için
    // okuma herkese açık; sadece {email} alanı tutulur, başka hiçbir profil bilgisi yoktur.
    match /usernameEmailMap/{username} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    // Vision API aylık kullanım sayacı
    // Sayaç sadece artabilir — reset/azaltma engellenir
    match /visionUsage/{ayDoc} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
      // İlk yazım: en fazla 50 sayfa
      allow create: if request.auth != null &&
        request.resource.data.sayfaSayisi is number &&
        request.resource.data.sayfaSayisi >= 0 &&
        request.resource.data.sayfaSayisi <= 50;
      // Güncelleme: sayaç sadece artabilir, tek istekte en fazla 50 artış
      allow update: if request.auth != null &&
        request.resource.data.sayfaSayisi is number &&
        request.resource.data.sayfaSayisi > resource.data.sayfaSayisi &&
        request.resource.data.sayfaSayisi - resource.data.sayfaSayisi <= 50;
    }

    // Uygulama sürüm bilgisi ("Hakkında" sayfasındaki güncelleme kontrolü)
    // Herkes okuyabilir, sadece admin/superadmin güncelleyebilir.
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
  }
}
