rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // İşe ait dosyalar (fotoğraf, fatura, vergi borcu yoktur belgesi vb.)
    // Erişim, firestore.rules'daki projeler koleksiyonuyla aynı desende:
    // proje sahibi, projeye atanan gerçekleştirmeci, admin/superadmin.
    match /projeDosyalari/{projeId}/{dosyaAdi} {

      function projeVar() {
        return firestore.exists(/databases/(default)/documents/projeler/$(projeId));
      }
      function proje() {
        return firestore.get(/databases/(default)/documents/projeler/$(projeId)).data;
      }
      function kullaniciVar() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
      }
      function kullaniciRol() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
      }
      function yetkili() {
        return request.auth != null && projeVar() && (
          proje().userId == request.auth.uid ||
          proje().atananGerceklestirmeciUid == request.auth.uid ||
          (kullaniciVar() && kullaniciRol() in ['admin', 'superadmin'])
        );
      }

      allow read: if yetkili();

      // En fazla 10 MB, sadece resim/PDF/Office belgeleri
      allow create: if yetkili() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\..*|application/vnd\\.ms-excel');

      allow delete: if yetkili();
    }
  }
}
